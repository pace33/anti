    <Item class="Script" referent="1870">
      <Properties>
        <string name="Name">Regenerate Castle</string>
        <bool name="Disabled">false</bool>
        <Content name="LinkedSource">
          <null>
          </null>
        </Content>
        <string name="Source">model = game.Workspace.Regen
messageText = "Regenerating Bridges..."

message = Instance.new("Message")
message.Text = messageText
backup = model:clone()

while true do
	wait(300)

	message.Parent = game.Workspace
	model:remove()

	wait(4)

	model = backup:clone()
	model.Parent = game.Workspace
	model:makeJoints()
	message.Parent = nil
end
</string>
      </Properties>
    </Item>
